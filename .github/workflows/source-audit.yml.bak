name: Audit automatico delle fonti

on:
  schedule:
    # Il 15 di ogni mese. L'orario UTC evita dipendenze dal cambio ora locale.
    - cron: "17 07 15 * *"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: source-audit
  cancel-in-progress: false

jobs:
  audit:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30af803 # v6
        with:
          persist-credentials: false

      - name: Setup Python
        uses: actions/setup-python@e797f83bcb11b83ae66e0230d6156d7c80228e7c # v6
        with:
          python-version: "3.12"

      - name: Ripristina baseline precedente
        uses: actions/cache/restore@v4
        with:
          path: .audit-state
          key: source-audit-state-${{ github.run_id }}
          restore-keys: source-audit-state-

      - name: Audit fonti ufficiali
        id: audit
        run: python3 scripts/audit/controlla_fonti.py --state .audit-state/source-audit-state.json --report audit-source-status.json

      - name: Salva baseline aggiornata
        if: always()
        uses: actions/cache/save@v4
        with:
          path: .audit-state
          key: source-audit-state-${{ github.run_id }}

      - name: Pubblica report audit
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: source-audit-${{ github.run_number }}
          path: audit-source-status.json
          if-no-files-found: error
          retention-days: 90
