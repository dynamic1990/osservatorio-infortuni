{
  "name": "osservatorio-infortuni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open data INAIL sugli infortuni sul lavoro, spiegati in modo semplice, verificabile e open source.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:etl": "python3 -m unittest discover -s tests/etl -p 'test_*.py'",
    "etl:infortuni": "python3 scripts/etl/inail_infortuni_snapshot.py"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "typescript": "^5.9.0"
  }
}
